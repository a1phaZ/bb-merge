{
  "name": "bitbucket-merge-request",
  "version": "1.0.0",
  "description": "Bitbucket Server merge request creator",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "cli": "ts-node src/cli.ts",
    "server": "ts-node src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "chokidar": "^5.0.0",
    "commander": "^11.1.0",
    "cors": "^2.8.6",
    "dotenv": "^16.3.0",
    "express": "^4.18.0",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "joi": "^17.11.0",
    "js-yaml": "^4.1.0",
    "uuid": "^14.0.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/chokidar": "^1.7.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.0",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "express-serve-static-core": "4.19.8",
    "@types/express-serve-static-core": "4.19.8"
  }
}

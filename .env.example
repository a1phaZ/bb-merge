# Domain for Caddy (used in Caddyfile, e.g. app.yourdomain.com)
DOMAIN=localhost

# Server
PORT=3000
NODE_ENV=development

# Storage (file or sqlite)
STORAGE_TYPE=file
DATA_DIR=./data

# Encryption key for token storage (auto-generated if empty)
# ENCRYPTION_KEY=

# JWT secret for authentication (REQUIRED, generate with: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-random-secret

# Webhook secret for signature verification (optional)
# WEBHOOK_SECRET=

# Provider-specific defaults (optional)
# BITBUCKET_URL=https://bitbucket.mycompany.com
# BITBUCKET_USERNAME=username
# BITBUCKET_PASSWORD=app-password
